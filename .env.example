# Namuna fayl — nusxa oling: cp .env.example .env.local
# Bu yerda HECH QACHON haqiqiy qiymat turmasin, faqat o'zgaruvchi nomlari.

# Backend REST API manzili (oxirida /api/v1)
VITE_DEFAULT_URL=

# WebSocket manzili (ws:// lokal, wss:// production)
VITE_SOCKET_URL=

# Hash bilan ishlaydigan yordamchi API manzili (ixtiyoriy)
VITE_HASHED_URL=

# Google Maps JavaScript API kaliti.
# Kalit Google Cloud Console'da yaratiladi va HTTP referrer bo'yicha cheklanadi.
VITE_GOOGLE_MAP_API_KEY=

# Monitoring xaritasi uchun uslub (style JSON) manzili.
# BO'SH qoldirilsa xarita o'chadi va tashqi serverga hech qanday so'rov ketmaydi.
# Ichki serverga yo'naltirish mumkin, masalan:
#   VITE_MAP_STYLE_URL=https://tiles.ichki-tarmoq.uz/styles/positron
VITE_MAP_STYLE_URL=
